/*========================================================================================================
    📊 CUMULATIVE ANALYSIS
    Description:
        This section focuses on analyzing cumulative trends over time using window functions.

    Key Metrics:
        - Total Sales
        - Running Total (Cumulative Sales)
        - Moving Average Price

    Concepts Used:
        - Window Functions (SUM() OVER, AVG() OVER)
        - Date Truncation (DATETRUNC)
========================================================================================================*/


-- ====================================================================================
-- 🟦 MONTHLY CUMULATIVE ANALYSIS (OVER TIME)
-- ====================================================================================

/*
    Objective:
        - Calculate total monthly sales
        - Compute running total of sales over time
        - Calculate moving average of product price
*/


SELECT
    order_month,
    total_sales,
    SUM(total_sales) OVER (ORDER BY order_month) AS running_total_sales,
    AVG(avg_price) OVER (ORDER BY order_month) AS moving_avg_price
FROM
(
    SELECT
        DATETRUNC(MONTH, order_date) AS order_month,
        SUM(sales_amount) AS total_sales,
        AVG(price) AS avg_price
    FROM gold.fact_sales
    WHERE order_date IS NOT NULL
    GROUP BY DATETRUNC(MONTH, order_date)
) AS monthly_data;



-- ====================================================================================
-- 🟩 MONTHLY ANALYSIS (WITH PARTITION - DEMONSTRATION PURPOSE)
-- ====================================================================================

/*
    Note:
        PARTITION BY order_month does not add value here because each month is unique.
        This is included for learning purposes only.
*/

SELECT
    order_month,
    total_sales,
    SUM(total_sales) OVER (PARTITION BY order_month ORDER BY order_month) AS running_total,
    AVG(avg_price) OVER (PARTITION BY order_month ORDER BY order_month) AS moving_avg_price
FROM
(
    SELECT
        DATETRUNC(MONTH, order_date) AS order_month,
        SUM(sales_amount) AS total_sales,
        AVG(price) AS avg_price
    FROM gold.fact_sales
    WHERE order_date IS NOT NULL
    GROUP BY DATETRUNC(MONTH, order_date)
) AS monthly_partitioned;



-- ====================================================================================
-- 🟥 YEARLY CUMULATIVE ANALYSIS (OVER TIME)
-- ====================================================================================

/*
    Objective:
        - Aggregate yearly sales
        - Compute cumulative yearly sales
        - Track moving average price trends
*/

SELECT
    order_year,
    total_sales,
    SUM(total_sales) OVER (ORDER BY order_year) AS running_total_sales,
    AVG(avg_price) OVER (ORDER BY order_year) AS moving_avg_price
FROM
(
    SELECT
        DATETRUNC(YEAR, order_date) AS order_year,
        SUM(sales_amount) AS total_sales,
        AVG(price) AS avg_price
    FROM gold.fact_sales
    WHERE order_date IS NOT NULL
    GROUP BY DATETRUNC(YEAR, order_date)
) AS yearly_data;



-- ====================================================================================
-- 🟨 YEARLY ANALYSIS (WITH PARTITION - DEMONSTRATION PURPOSE)
-- ====================================================================================

/*
    Note:
        PARTITION BY order_year is redundant here for the same reason as above.
        Included for conceptual clarity.
*/

SELECT
    order_year,
    total_sales,
    SUM(total_sales) OVER (PARTITION BY order_year ORDER BY order_year) AS running_total,
    AVG(avg_price) OVER (PARTITION BY order_year ORDER BY order_year) AS moving_avg_price
FROM
(
    SELECT
        DATETRUNC(YEAR, order_date) AS order_year,
        SUM(sales_amount) AS total_sales,
        AVG(price) AS avg_price
    FROM gold.fact_sales
    WHERE order_date IS NOT NULL
    GROUP BY DATETRUNC(YEAR, order_date)
) AS yearly_partitioned;
